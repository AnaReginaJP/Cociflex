# AI for recipes (any OpenAI-compatible API: Ollama, LM Studio or DeepSeek)
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="qwen2.5:7b"
# DeepSeek in the cloud: replace the two lines above with these and add the key.
# Needs internet; without a valid LLM_API_KEY it answers 503 and the app uses its rules.
# LLM_BASE_URL="https://api.deepseek.com/v1"
# LLM_MODEL="deepseek-chat"
# LLM_API_KEY="MY_DEEPSEEK_KEY"
# Optional tuning
# LLM_TIMEOUT_MS=600000
# LLM_MAX_TOKENS=1100
# LLM_MAX_CONCURRENT=1
# LLM_MAX_QUEUE=2

# MariaDB connection used by the app (needs SELECT/INSERT/UPDATE/DELETE)
SQL_HOST="localhost"
SQL_PORT=3306
SQL_USER="MY_DB_USER"
SQL_PASSWORD="MY_DB_PASSWORD"
SQL_DB_NAME="cociflex"

# Admin credentials, only used by `npm run db:push` to create the tables
SQL_ADMIN_USER="MY_DB_ADMIN_USER"
SQL_ADMIN_PASSWORD="MY_DB_ADMIN_PASSWORD"

# Optional
PORT=3000
NODE_ENV="development"
