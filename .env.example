# Gemini API key (used only on the server, never in the browser)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PostgreSQL connection
SQL_HOST="localhost"
SQL_USER="MY_DB_USER"
SQL_PASSWORD="MY_DB_PASSWORD"
SQL_DB_NAME="cociflex"

# Admin credentials, only used by drizzle-kit to create the tables
SQL_ADMIN_USER="MY_DB_ADMIN_USER"
SQL_ADMIN_PASSWORD="MY_DB_ADMIN_PASSWORD"

# Optional
PORT=3000
NODE_ENV="development"
