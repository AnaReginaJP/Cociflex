{
  "name": "react-example",
  "private": true,
  "version": "4.2.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"for (const p of ['dist','release','cociflex-release.tar.gz']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --test src/utils/*.test.ts src/ai/*.test.ts",
    "check": "npm run lint && npm test && npm run build",
    "db:push": "drizzle-kit push --config src/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config src/db/drizzle.config.ts",
    "db:dev": "node scripts/dev-db.mjs",
    "release": "node deploy/build-release.mjs",
    "servidor:actualizar": "node deploy/actualizar-servidor.mjs",
    "servidor:anterior": "node deploy/actualizar-servidor.mjs anterior"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.11.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
